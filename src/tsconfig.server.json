{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["api/**/*.ts", "scripts/**/*.ts", "services/firebase/adminServer.ts", "services/server/**/*.ts", "services/cloudinary/**/*.ts", "config/media.ts", "utils/orderState.ts", "utils/mediaUrl.ts", "types/**/*.ts", "data/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
