{
  "name": "desiraluxe-ecommerce",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-desiraluxe-rules \"vitest run --config vitest.rules.config.ts\"",
    "test:e2e": "playwright test",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "bootstrap:firebase": "tsx scripts/bootstrapFirestore.ts",
    "provision:admin": "tsx scripts/provisionAdmin.ts",
    "authorize:admin": "tsx scripts/authorizeAdmin.ts",
    "deploy:firestore": "firebase deploy --only firestore:rules,firestore:indexes --project e-commerce-711c0"
  },
  "dependencies": {
    "@mantine/core": "7.17.3",
    "@mantine/hooks": "7.17.3",
    "@radix-ui/react-icons": "1.3.2",
    "date-fns": "4.1.0",
    "firebase": "11.7.1",
    "firebase-admin": "13.4.0",
    "framer-motion": "11.18.2",
    "lucide-react": "0.577.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.2",
    "recharts": "2.15.1",
    "sonner": "1.7.4",
    "tailwind-merge": "2.6.1",
    "zod": "3.24.4"
  },
  "devDependencies": {
    "@eslint/js": "9.26.0",
    "@firebase/rules-unit-testing": "4.0.1",
    "@playwright/test": "1.52.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.15.3",
    "@types/react": "18.3.20",
    "@types/react-dom": "18.3.6",
    "@vitejs/plugin-react": "4.4.1",
    "autoprefixer": "10.4.21",
    "eslint": "9.26.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "firebase-tools": "14.3.1",
    "jsdom": "26.1.0",
    "postcss": "8.5.3",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "typescript-eslint": "8.32.0",
    "vite": "6.3.5",
    "vitest": "3.1.3"
  }
}
